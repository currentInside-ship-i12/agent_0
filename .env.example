# (enterprise keys fail with 400 without it).
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
# Google Gemini (via OpenAI-compatible endpoint). GOOGLE_API_KEY also accepted.
GEMINI_API_KEY=
FIRECRAWL_API_KEY=
GMAPS_API_KEY=
